# Copy this file to .env and fill it in from the Firebase console:
# Project settings → General → Your apps → the Web app → SDK setup and configuration → Config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Step 11 (optional): photos to Storage, and the Local Emulator Suite
EXPO_PUBLIC_UPLOAD_PHOTOS=0
EXPO_PUBLIC_USE_EMULATORS=0
# 10.0.2.2 = your PC, seen from the Android emulator; a phone: your PC's LAN address
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2
