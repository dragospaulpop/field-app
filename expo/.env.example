# Copy this file to .env. Week 5: your Supabase project (step 1). The URL and the PUBLISHABLE key only:
# `supabase projects api-keys` lists them (the `publishable` one, sb_publishable_...).
# Never the secret key: everything in an EXPO_PUBLIC_ variable ends up inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
